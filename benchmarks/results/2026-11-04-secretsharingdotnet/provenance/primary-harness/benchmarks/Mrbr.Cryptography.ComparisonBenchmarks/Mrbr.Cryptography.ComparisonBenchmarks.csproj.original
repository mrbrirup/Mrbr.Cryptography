<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ComparisonTargetFramework Condition="'$(ComparisonTargetFramework)' == ''">net11.0</ComparisonTargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <ProjectReference Include="../../src/Mrbr.Cryptography/Mrbr.Cryptography.csproj" />
    <ProjectReference Include="../../Comparison/SecretSharingDotNet-main/src/SecretSharingDotNet.csproj"
                      SetTargetFramework="TargetFramework=$(ComparisonTargetFramework)"
                      AdditionalProperties="TargetFramework=$(ComparisonTargetFramework)"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
</Project>
